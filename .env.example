# Koubox 日志配置（复制为项目根目录的 .env 后，pnpm dev 启动时生效）
# 日志等级：debug | info | warn | error
KOUBOX_LOG_LEVEL=debug
# 详细模式：true 时附加结构化详情；false 时只输出单行摘要
KOUBOX_LOG_VERBOSE=true

# 授权必须走 Cloudflare 远端；禁止 localhost / 127.0.0.1
KOUBOX_LICENSE_API_URL=https://koubox-license.ypyt147.workers.dev
KOUBOX_LICENSE_TOKEN=
KOUBOX_LICENSE_API_KEY=
KOUBOX_LICENSE_CREDENTIAL_VERSION=2
