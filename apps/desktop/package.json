{
  "name": "@koubox/desktop",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "set \"ELECTRON_RUN_AS_NODE=\" && set \"ELECTRON_EXEC_PATH=%CD%\\node_modules\\electron\\dist\\electron.exe\" && electron-vite dev",
    "build": "electron-vite build",
    "prepare:playwright-browsers": "node ../../scripts/prepare-playwright-browsers.mjs",
    "prepare:license-package": "node scripts/prepare-license-package.mjs",
    "package": "pnpm prepare:license-package && pnpm prepare:playwright-browsers && pnpm build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@koubox/core": "workspace:*",
    "@koubox/license-client": "workspace:*",
    "@koubox/shared": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "playwright": "^1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "selfsigned": "4.0.1",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "33.4.11",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.koubox.desktop",
    "productName": "口播匣",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../vendor",
        "to": "vendor"
      },
      {
        "from": "../../python/.venv",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../../python/src",
        "to": "python/src"
      },
      {
        "from": "../../png/口播匣icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../.pack/playwright-browsers",
        "to": "playwright-browsers"
      },
      {
        "from": "../../.pack/license",
        "to": "license"
      }
    ],
    "afterPack": "./scripts/after-pack.cjs",
    "electronDist": "node_modules/electron/dist",
    "compression": "store",
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
